MultiTurnAgent[@T]: {
    S: SYSTEM_PROMPT
    S: HISTORY_SYSTEM_PROMPT

    If @T > 1 {
        ForEach(t: range(1, @T)) {
            U: sys.history[@t].instruction
            A: sys.history[@t].generated_command
        }
    }
    
    // The current turn
    U: env.instruction[@T]

    If resp.call_tool {
        A: resp.call_tool[@T].response
    }
    Else {
        A: resp.not_possible[@T]
    }
}