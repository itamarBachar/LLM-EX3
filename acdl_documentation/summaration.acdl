HistorySummarizer[@T]: {
    S: SUMMARIZATION_PROMPT // Instructions on how to compress shell interactions.
    
    
        ForEach(t: range(sys.compaction_keep + 1, @T)) {
            U: sys.history[@t].instruction
            A: sys.history[@t].generated_command
            T: sys.history[@t].bash_response
        }
    
}