ErrorRecoveryAgent[@T]: {
    S: {
        SYSTEM_PROMPT
        If sys.memory[@T] {
            PERSISTENT_MEMORIES(sys.memory[@T])
        }
        If @T > 1 {
            CONVERSATION_HISTORY
            ForEach(t: range(1, @T)) {
                sys.history[@t].instruction
                sys.history[@t].response
                If sys.history[@t].returncode != 0 {
                    sys.history[@t].stderr
                    ERROR_RECOVERY_PROMPT
                }
            }
        }
    }
    U: {
        env.instruction[@T]
    }
    A: resp.bash_response[@T]
}
